# ---------------------------------------------------------------------------
# Warrigal Park FC — test environment
# Used by the automated test suite and by CI.  The test suite overrides
# APP_DB_PATH with a temporary directory, so this file is mainly documentation
# of the shape a test environment takes.
# ---------------------------------------------------------------------------
APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=0
APP_DB_PATH=data/test.db
APP_SEED=true
APP_DEBUG=false
APP_SECRET_KEY=test-only-secret
