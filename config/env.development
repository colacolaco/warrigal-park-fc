APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DB_PATH=data/warrigal_park.db
APP_SEED=true
APP_DEBUG=true
APP_SECRET_KEY=development-only-secret-do-not-use-in-production
