# ---------------------------------------------------------------------------
# Warrigal Park FC — production environment shape
#
# This file records the shape of the production configuration.  It contains NO
# real secrets: APP_SECRET_KEY is a placeholder and must be supplied by the host
# as a real environment variable, which takes precedence over any file.
#
# Do not copy this file to `.env` on a shared machine.  Set the variables in the
# service definition instead (see deploy/warrigal-park.service).
# ---------------------------------------------------------------------------
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080

# Outside the repository, on a backed-up volume, writable by the service account.
APP_DB_PATH=/var/lib/warrigal-park/warrigal_park.db

# Never seed a production database with the fictitious sample roster.
APP_SEED=false

APP_DEBUG=false

# PLACEHOLDER — replace with the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=REPLACE-WITH-A-REAL-SECRET
