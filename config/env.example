# ---------------------------------------------------------------------------
# Warrigal Park FC — configuration template for every environment
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the project root and edit the values for your
# machine.  The `.env` file is git-ignored on purpose: environment-specific
# settings must never be committed to the repository (see
# docs/BRANCHING_STRATEGY.md, section "Configuration management").
#
#   cp config/env.example .env
#
# Every value below is optional; the default shown is used when the variable
# is absent, so the application also runs correctly with no `.env` at all.
# ---------------------------------------------------------------------------

# Which environment this checkout represents: development | test | production
APP_ENV=development

# Where the development server listens.  Use 0.0.0.0 inside a container.
APP_HOST=127.0.0.1
APP_PORT=5000

# SQLite database file, relative to the project root.
APP_DB_PATH=data/warrigal_park.db

# Optional full database URL.  When set it overrides APP_DB_PATH.
# Development / test:
# DATABASE_URL=sqlite:///data/warrigal_park.db
# Production (example, PostgreSQL):
# DATABASE_URL=postgresql://user:password@db-host:5432/warrigal_park

# Load the fictitious sample roster on first start (development only).
APP_SEED=true

# Verbose request logging: true | false
APP_DEBUG=false

# Secret used to sign the session cookie.  NEVER commit a real secret.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-before-production
